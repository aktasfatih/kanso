#
# Copy to `.env` and fill in. The server reads this file, so your MCP client
# config never has to carry credentials. `.env` is gitignored.
#
# NEXTCLOUD_PASSWORD must be a Nextcloud *app password*, NOT your login password:
#   Nextcloud → Settings → Security → Devices & sessions → Create new app password
# App passwords are scoped and can be revoked any time without changing your login.

NEXTCLOUD_HOST=https://cloud.example.com
NEXTCLOUD_USERNAME=alice
NEXTCLOUD_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx

# Optional
# VERIFY_SSL=true
# MCP_HOST=127.0.0.1
# MCP_PORT=7654
